# Satır sonları: Windows ve Mac arasında sorun çıkmasın
* text=auto

# Büyük 3B ve model dosyaları Git LFS ile saklanır
*.blend  filter=lfs diff=lfs merge=lfs -text lockable
*.glb    filter=lfs diff=lfs merge=lfs -text lockable
*.gltf   filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.obj    filter=lfs diff=lfs merge=lfs -text
*.zprj   filter=lfs diff=lfs merge=lfs -text lockable
*.zpac   filter=lfs diff=lfs merge=lfs -text lockable
*.onnx   filter=lfs diff=lfs merge=lfs -text
*.pt     filter=lfs diff=lfs merge=lfs -text
*.pth    filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.hdr    filter=lfs diff=lfs merge=lfs -text

# Doku görselleri yalnızca assets klasöründe LFS'e gider
assets/**/*.png  filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
blender/**/*.png filter=lfs diff=lfs merge=lfs -text
blender/**/*.jpg filter=lfs diff=lfs merge=lfs -text
